<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" style="-fx-background-color: transparent;" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.kiastore.ui.controller.SuppliersController"
      nodeOrientation="RIGHT_TO_LEFT">

    <!-- Right Side: Suppliers List -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" prefWidth="600">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="قائمة الموردين" style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAddSupplier" text="➕  إضافة مورد جديد" onAction="#onAddNewSupplier"
                    style="-fx-background-color: #FAA11F; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS" 
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 4; -fx-background-radius: 4;">
            <columns>
                <TableColumn fx:id="colName" text="الاسم" prefWidth="150"/>
                <TableColumn fx:id="colPhone" text="رقم الهاتف" prefWidth="120"/>
                <TableColumn fx:id="colAddress" text="العنوان" prefWidth="150"/>
                <TableColumn fx:id="colNotes" text="ملاحظات" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Left Side: Add/Edit Form -->
    <VBox prefWidth="400" spacing="15">
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                    style="-fx-background-color: transparent; -fx-background: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8;">
            
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label fx:id="formHeaderLabel" text="بيانات المورد" 
                       style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
                
                <GridPane hgap="10" vgap="15">
                    <Label text="اسم المورد:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
                    <TextField fx:id="nameField" promptText="مثال: Bosch Egypt" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS"/>

                    <Label text="رقم الهاتف:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
                    <TextField fx:id="phoneField" promptText="01xxxxxxxxx" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="العنوان:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
                    <TextField fx:id="addressField" promptText="العنوان بالتفصيل" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <VBox spacing="8">
                    <Label text="ملاحظات المورد:" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
                    <TextArea fx:id="notesArea" promptText="منتجات المورد، شروط الدفع..." prefHeight="100" wrapText="true"/>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnDelete" text="🗑️  حذف" onAction="#onDeleteSupplier" 
                            style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="إلغاء" onAction="#onCancelEdit" 
                            style="-fx-background-color: transparent; -fx-text-fill: #363636; -fx-border-color: #363636; -fx-border-radius: 4; -fx-font-family: 'Tajawal'; -fx-cursor: hand;"/>
                    <Button fx:id="btnSave" text="💾  حفظ" onAction="#onSaveSupplier" 
                            style="-fx-background-color: #FAA11F; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

</HBox>
