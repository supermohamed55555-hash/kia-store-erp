<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" style="-fx-background-color: transparent;" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.kiastore.ui.controller.UsersController"
      nodeOrientation="RIGHT_TO_LEFT">

    <!-- Right Side: Users List -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" prefWidth="600">
        <HBox alignment="CENTER_LEFT">
            <Label text="إدارة حسابات الموظفين" style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="➕  إضافة موظف جديد" onAction="#onAddNewUser"
                    style="-fx-background-color: #FAA11F; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" 
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 4; -fx-background-radius: 4;">
            <columns>
                <TableColumn fx:id="colId" text="المعرف" prefWidth="60"/>
                <TableColumn fx:id="colName" text="الاسم الكامل" prefWidth="180"/>
                <TableColumn fx:id="colUsername" text="اسم المستخدم" prefWidth="150"/>
                <TableColumn fx:id="colRole" text="الصلاحية / الدور" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Left Side: Add/Edit User Form -->
    <VBox prefWidth="400" spacing="15" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8;">
        <Label fx:id="formHeaderLabel" text="بيانات حساب الموظف" 
               style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
        
        <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS">
            <Label text="الاسم الكامل:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
            <TextField fx:id="nameField" promptText="أحمد علي" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS"/>

            <Label text="اسم المستخدم:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
            <TextField fx:id="usernameField" promptText="ahmed12" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="كلمة المرور:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
            <PasswordField fx:id="passwordField" promptText="كلمة مرور جديدة" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="الصلاحية:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-family: 'Tajawal'; -fx-font-size: 13;"/>
            <ComboBox fx:id="roleComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnDelete" text="🗑️  تعطيل الحساب" onAction="#onDeleteUser" 
                    style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="إلغاء" onAction="#onCancelEdit" 
                    style="-fx-background-color: transparent; -fx-text-fill: #363636; -fx-border-color: #363636; -fx-border-radius: 4; -fx-font-family: 'Tajawal'; -fx-cursor: hand;"/>
            <Button fx:id="btnSave" text="💾  حفظ" onAction="#onSaveUser" 
                    style="-fx-background-color: #FAA11F; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</HBox>
