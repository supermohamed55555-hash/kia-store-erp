<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.openjfx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kiastore.ui.controller.SettingsController"
      styleClass="content-area"
      spacing="0"
      style="-fx-background-color: #F3F4F6;">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #FFFFFF; -fx-padding: 18 24; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
        <Label text="⚙️" style="-fx-font-size: 22;"/>
        <VBox>
            <Label text="الإعدادات" style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
            <Label text="إدارة النسخ الاحتياطي، استعادة البيانات، وإعدادات النظام"
                   style="-fx-font-family: 'Tajawal'; -fx-font-size: 11; -fx-text-fill: #6B7280;"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- ===== Backup & Restore Section ===== -->
            <VBox spacing="14"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-width: 1;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🛡️" style="-fx-font-size: 18;"/>
                    <VBox>
                        <Label text="النسخ الاحتياطي واستعادة البيانات"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="تصدير قاعدة البيانات كاملة أو استعادة نسخة سابقة — متاح للمشرف فقط"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 11; -fx-text-fill: #6B7280;"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Status Label -->
                <Label fx:id="backupStatusLabel" text="" wrapText="true"
                       style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-text-fill: #6B7280;"/>

                <!-- Progress Bar -->
                <ProgressBar fx:id="backupProgress" prefWidth="10000" prefHeight="6" progress="0"
                             visible="false"
                             style="-fx-accent: #3B82F6; -fx-background-radius: 3;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <!-- Backup Button -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="📤  نسخ احتياطي"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                        <Label text="تصدير قاعدة بيانات kia_store_erp إلى ملف .sql على جهازك"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 10; -fx-text-fill: #6B7280;" wrapText="true"/>
                        <Button fx:id="btnBackup" text="إنشاء نسخة احتياطية  →" onAction="#onBackup"
                                style="-fx-background-color: #3B82F6; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 6;"/>
                    </VBox>

                    <Separator orientation="VERTICAL" prefHeight="80"/>

                    <!-- Restore Button -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="📥  استعادة البيانات"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                        <Label text="استيراد ملف .sql لاستعادة قاعدة البيانات — سيتم إعادة تشغيل النظام"
                               style="-fx-font-family: 'Tajawal'; -fx-font-size: 10; -fx-text-fill: #DC2626;" wrapText="true"/>
                        <Button fx:id="btnRestore" text="استعادة من نسخة احتياطية  →" onAction="#onRestore"
                                style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 6;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ===== System Info Section ===== -->
            <VBox spacing="12"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-width: 1;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="ℹ️" style="-fx-font-size: 18;"/>
                    <Label text="معلومات النظام"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>
                <Separator/>
                <GridPane hgap="20" vgap="10">
                    <Label text="إصدار التطبيق:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-text-fill: #6B7280;"/>
                    <Label text="KIA Store ERP v1.0.0" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-font-weight: bold;"/>
                    <Label text="قاعدة البيانات:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-text-fill: #6B7280;"/>
                    <Label text="MySQL — kia_store_erp (localhost:3306)" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-font-weight: bold;"/>
                    <Label text="مسار MySQL:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 12; -fx-text-fill: #6B7280;"/>
                    <Label text="C:\xampp\mysql\bin\" GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-text-fill: #374151;"/>
                </GridPane>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
