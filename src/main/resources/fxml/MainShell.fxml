<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kiastore.ui.controller.MainShellController"
      style="-fx-background-color: #F8F9FA;"
      nodeOrientation="RIGHT_TO_LEFT"
      prefWidth="1150" prefHeight="750">

    <!-- Center Content Area (Left side in RTL) -->
    <VBox HBox.hgrow="ALWAYS">
        <!-- Top Bar with Persistent Search -->
        <HBox alignment="CENTER_LEFT" spacing="20" 
              style="-fx-background-color: #FFFFFF; -fx-padding: 12 25; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 1);">
            
            <!-- Page Title & Theme Toggle on Right (first in RTL order) -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="pageTitle" text="الرئيسية" 
                       style="-fx-font-family: 'Tajawal'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
                <Button text="🌓" onAction="#onToggleTheme" 
                        style="-fx-background-color: transparent; -fx-font-size: 15; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Centered Search Bar with Icon -->
            <HBox alignment="CENTER_LEFT" spacing="8" maxWidth="380" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 2 12; -fx-border-color: #E5E7EB; -fx-border-radius: 20; -fx-border-width: 1;">
                <Label text="🔍" style="-fx-font-size: 13; -fx-text-fill: #707070;"/>
                <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label fx:id="searchSuggestionLabel" text="" 
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-text-fill: #B0B0B0; -fx-mouse-transparent: true;"/>
                    <TextField fx:id="globalSearchField" promptText="بحث سريع عن قطع الغيار..." onKeyReleased="#onGlobalSearchKeyReleased"
                               style="-fx-background-color: transparent; -fx-padding: 6 0; -fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-text-fill: #363636;" 
                               HBox.hgrow="ALWAYS"/>
                </StackPane>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Left Side: User Status & Avatar (last in RTL order) -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox alignment="CENTER_RIGHT" spacing="1">
                    <Label fx:id="topUserLabel" text="اسم المستخدم" 
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #363636;"/>
                    <Label fx:id="topRoleLabel" text="المدير" 
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 10; -fx-text-fill: #707070;"/>
                </VBox>
                <StackPane style="-fx-background-color: #FAA11F; -fx-background-radius: 16; -fx-min-width: 32px; -fx-min-height: 32px; -fx-max-width: 32px; -fx-max-height: 32px;">
                    <Label text="👤" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14;"/>
                </StackPane>
            </HBox>
        </HBox>
        
        <!-- Main Content Swappable Pane -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">
            <!-- Sub-views are injected here -->
        </StackPane>
    </VBox>

    <!-- Collapsible Sidebar (Right side in RTL) -->
    <VBox fx:id="sidebar" prefWidth="240" maxWidth="240" minWidth="60"
          styleClass="sidebar" style="-fx-padding: 10 0 20 0;">
        
        <!-- Sidebar Brand Header -->
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15 10 20 10;">
            <Label fx:id="sidebarBrandLabel" text="KIA Store" 
                   style="-fx-font-family: 'Tajawal'; -fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: #FAA11F;"/>
            <Button fx:id="btnCollapse" text="☰" onAction="#onToggleSidebar"
                    style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-cursor: hand;"/>
        </HBox>
        
        <!-- Navigation Buttons -->
        <VBox spacing="2" VBox.vgrow="ALWAYS">
            <Button fx:id="navWelcome" text="🏠  الرئيسية" onAction="#showWelcome"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navDashboard" text="📊  لوحة التحكم" onAction="#showDashboard"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <StackPane alignment="CENTER_LEFT">
                <Button fx:id="navParts" text="⚙️  إدارة الأصناف" onAction="#showParts"
                        styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
                <Label fx:id="lowStockBadge" text="0" visible="false" mouseTransparent="true"
                       style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-background-radius: 10; -fx-padding: 2 6; -fx-font-family: 'Tajawal'; -fx-font-size: 10; -fx-font-weight: bold; -fx-translate-x: 200;"/>
            </StackPane>
            
            <Button fx:id="navInvoices" text="📄  الفواتير والمبيعات" onAction="#showInvoices"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navCustomerLedger" text="📒  حسابات العملاء والآجل" onAction="#showCustomerLedger"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navSuppliers" text="🤝  إدارة الموردين" onAction="#showSuppliers"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navReceiving" text="📥  استلام المخزون" onAction="#showReceiving"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navAuditLog" text="📋  سجل العمليات" onAction="#showAuditLog"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
            
            <Button fx:id="navUsers" text="👥  إدارة المستخدمين" onAction="#showUsers"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>

            <Button fx:id="navSettings" text="⚙️  الإعدادات والنسخ الاحتياطي" onAction="#showSettings"
                    styleClass="sidebar-btn" prefWidth="240" alignment="BASELINE_LEFT"/>
        </VBox>
        
        <!-- User Profile Card in Sidebar -->
        <VBox style="-fx-padding: 0 15 10 15;">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-user-box">
                <StackPane styleClass="avatar-circle">
                    <Label text="👤" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18;"/>
                </StackPane>
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Label fx:id="userLabel" text="اسم المستخدم" 
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <Label fx:id="roleLabel" text="المدير" 
                           style="-fx-font-family: 'Tajawal'; -fx-font-size: 10; -fx-text-fill: #A0AEC0;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Logout Button -->
        <Button text="🚪  تسجيل الخروج" onAction="#onLogout"
                style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-family: 'Tajawal'; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;" 
                prefWidth="240" alignment="BASELINE_LEFT"/>
    </VBox>
</HBox>
